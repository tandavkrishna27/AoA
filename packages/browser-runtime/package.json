{
  "name": "@armyofagents/browser-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": "./dist/runner.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@armyofagents/shared": "workspace:*",
    "@armyofagents/worker-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "playwright": "^1.58.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
