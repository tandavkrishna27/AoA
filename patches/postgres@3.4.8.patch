diff --git a/src/connection.js b/src/connection.js
--- a/src/connection.js
+++ b/src/connection.js
@@ -254,2 +254,12 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   function nextWrite(fn) {
+    // AoA patch: a write queued via setImmediate can fire AFTER the connection was
+    // torn down and `socket` nulled (rapid teardown under heavy test churn), throwing
+    // "Cannot read properties of null (reading 'write')" as an uncaught exception on a
+    // later tick. Guard the deferred flush: if the socket is gone there is nothing to
+    // write to — clear pending state and no-op. Live connections are unaffected.
+    if (!socket) {
+      nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      return false
+    }
     const x = socket.write(chunk, fn)
@@ -390,2 +400,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   function errored(err) {
+    // Complete pending COPY finalization on backend rejection or connection loss.
+    // Its query promise already resolved to the stream, so reject alone cannot
+    // notify pipeline after CopyDone has been sent.
+    if (final) {
+      const complete = final
+      final = null
+      complete(err)
+    }
     stream && (stream.destroy(err), stream = null)
@@ -870,3 +888,3 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         final = callback
-        stream = null
+        // Retain the writable until CommandComplete/ErrorResponse acknowledges COPY.
       }
